ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/velox_monitoring
ARC_CHAIN_ID=5042
# Production requires explicit verified final deployment addresses. Local API
# development uses the configured local Core (or Core reference) and the
# verified Steakhouse Adapter in read-only mode when both values are absent;
# a partial address configuration fails closed.
VELOX_TREASURY_CORE_ADDRESS=
STEAKHOUSE_ADAPTER_ADDRESS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
