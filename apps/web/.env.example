# Browser-safe Reown Project ID from the existing Reown Dashboard project.
# Vite exposes VITE_* values to the browser; never put private keys or API secrets here.
VITE_REOWN_PROJECT_ID=

# Explicit verified final deployment addresses only. Configure both values for
# the deployment being built. Blank values leave Treasury contract functionality
# unavailable; they never fall back to live references.
VITE_ARC_MAINNET_CORE_ADDRESS=
VITE_ARC_MAINNET_STEAKHOUSE_ADAPTER_ADDRESS=
# Optional historical eth_getLogs chunk size; must be 1-100000.
# The conservative default is 10000 blocks per request for Arc Mainnet RPC.
VITE_ARC_MAINNET_LOG_CHUNK_SIZE=

# In local API route development only, server handlers use the project's existing
# Core/Adapter references in explicitly read-only reference mode when API final
# addresses are absent. Browser contract actions do not use these read references.
# Public Arc Mainnet RPC used by the local API route handlers for the existing /api/core-state and /api/strategy-state reads.
# Set this in your local .env or .env.local before running the web dev server.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Server-only wallet-auth settings. Configure these in the server runtime, not in VITE_* variables.
POSTGRES_URL=
AUTH_ORIGIN=http://localhost:5173
# Supply a secret of at least 32 bytes from the deployment secret manager. Never commit the value.
AUTH_SESSION_SECRET=

# Production-only, valuation-sync cron execution settings. The scheduled route
# is valuation-only and verifies the Core Policy Admin and Automation roles,
# signer identity, deployment identities, simulation, and receipt readback.
VELIX_TREASURY_CORE_ADDRESS=
STEAKHOUSE_ADAPTER_ADDRESS=
ARC_MAINNET_CORE_AUTOMATION_EXECUTOR=
DEPLOYER_PRIVATE_KEY=
# Configure the same random secret in the Vercel Production environment.
CRON_SECRET=
