{
  "name": "@velox/contracts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "check": "tsc --noEmit",
    "export:abi": "hardhat run scripts/export-abi.ts",
    "rehearsal:check": "hardhat run scripts/check-arc-testnet-rehearsal.ts",
    "deploy:arc-testnet:check": "hardhat run scripts/check-arc-testnet-deployment.ts",
    "deploy:arc-testnet": "hardhat run --network arcTestnet scripts/deploy-arc-testnet.ts",
    "deploy:arc-mainnet:legacy": "hardhat run --network arcMainnet scripts/deploy-arc-mainnet.ts",
    "deploy:arc-mainnet:check": "hardhat run scripts/check-arc-mainnet-deployment.ts",
    "deploy:arc-mainnet": "pnpm run deploy:arc-mainnet:legacy",
    "deploy:arc-mainnet:core:check": "hardhat run scripts/check-arc-mainnet-core-deployment.ts",
    "deploy:arc-mainnet:core": "hardhat run --network arcMainnet scripts/deploy-arc-mainnet-core.ts",
    "deploy:arc-mainnet:steakhouse:check": "hardhat run scripts/check-arc-mainnet-steakhouse-adapter-deployment.ts",
    "deploy:arc-mainnet:steakhouse": "hardhat run --network arcMainnet scripts/deploy-arc-mainnet-steakhouse-adapter.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@openzeppelin/contracts": "5.4.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.7.5",
    "chai": "4.5.0",
    "dotenv": "16.4.5",
    "ethers": "6.13.5",
    "hardhat": "2.17.4",
    "solc": "0.8.28",
    "typescript": "5.7.3"
  }
}
