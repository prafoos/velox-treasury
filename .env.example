# Public, non-secret deployment configuration values only.

# Established Arc Mainnet Core role holders; each address is assigned only to its
# matching role. Deployment validation still requires all roles to be distinct.
ARC_MAINNET_CORE_GOVERNANCE=0x37ab81b0b9C326F91426E57aa2E2D9273EF16F06
ARC_MAINNET_CORE_POLICY_ADMIN=0xeE55Baf61e6727FC48b141a10f0AB7A14aE0E9Df
ARC_MAINNET_CORE_TIMELOCK_EXECUTOR=0x7bb9655B227E6d47f8B929a0bd6261fa4063df4c
ARC_MAINNET_CORE_AUTOMATION_EXECUTOR=0x0ebad7ecda409d72aacc529efd46077d1cf012be
ARC_MAINNET_CORE_EMERGENCY=0x616647825Fc3cf69E5e7c5E474fF49a71FFB2596

# Final approved Core initial risk values and 10-minute valuation freshness.
ARC_MAINNET_CORE_VALUATION_FRESHNESS_BLOCKS=1200
ARC_MAINNET_CORE_MINIMUM_LIQUID_RESERVE=0
ARC_MAINNET_CORE_MINIMUM_LIQUID_RESERVE_BPS=1000
# 5,000,000 USDC in six-decimal USDC base units.
ARC_MAINNET_CORE_MAXIMUM_TOTAL_DEPLOYED=5000000000000

# Approved initial Admin-selected bucket values; total exactly 10000 BPS.
# Core defines its two-day timelock internally.
ARC_MAINNET_CORE_BUCKET_LIQUID_OPERATIONAL_RESERVE_BPS=5000
ARC_MAINNET_CORE_BUCKET_YIELD_STRATEGY_BUFFER_BPS=3000
ARC_MAINNET_CORE_BUCKET_SWEEP_LIQUIDITY_BUFFER_BPS=1000
ARC_MAINNET_CORE_BUCKET_AUTOMATION_AGENT_POOL_BPS=1000

# The final Core does not exist yet. Do not set this to the current live reference.
# ARC_MAINNET_FINAL_CORE_ADDRESS=
